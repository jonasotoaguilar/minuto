# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Mapbox Search Box configuration
# Use a PUBLIC / publishable token with Search Box access only.
# This token ships in the client app, so never use a secret token here.
# Recommended: create one token per environment/platform and add URL/app restrictions.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
